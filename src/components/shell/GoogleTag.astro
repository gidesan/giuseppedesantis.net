---
const gtagId = import.meta.env.GTAG_ID;
---

{
  gtagId && (
    <>
      <script
        is:inline
        src={"https://www.googletagmanager.com/gtag/js?id=" + gtagId}
      />
      <script
        is:inline
        set:html={`
            window.dataLayer = window.dataLayer || [];
            function gtag(){dataLayer.push(arguments);}
            gtag('js', new Date());
            gtag('config', '${gtagId}');
        `}
      />
    </>
  )
}
