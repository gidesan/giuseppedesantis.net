---
import IconTwitter from "@components/icons/IconTwitter.astro";
import IconGitHub from "@components/icons/IconGitHub.astro";
import IconLinkedIn from "@components/icons/IconLinkedIn.astro";
import { SITE, SOCIAL_LINKS, type SocialPlatform } from "@/site";

const icons: Record<SocialPlatform, typeof IconTwitter> = {
  twitter: IconTwitter,
  github: IconGitHub,
  linkedin: IconLinkedIn,
};
---

<ul class="flex list-none justify-evenly gap-8 p-0">
  {
    SOCIAL_LINKS.map((link) => {
      const Icon = icons[link.platform];
      return (
        <li>
          <a
            href={link.href}
            aria-label={`${SITE.author} on ${link.label}`}
            title={link.label}
          >
            <Icon />
          </a>
        </li>
      );
    })
  }
</ul>
